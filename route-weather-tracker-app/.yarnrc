# yarn classic delegates every command to this script before it parses
# package.json, so this is what catches `yarn install` and `yarn <script>`.
# Without it yarn stops on its own corepack check first and reports a
# genuinely confusing "packageManager": "yarn@npm@10.9.4" instead.
#
# See scripts/ensure-npm.cjs for the reasoning and the npm equivalents.
yarn-path "./scripts/ensure-npm.cjs"
