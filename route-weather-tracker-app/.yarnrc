# Fallback guard. yarn classic delegates a command to yarn-path before it does
# much else, so this catches `yarn install` / `yarn <script>` and routes them to
# the script that explains the npm equivalent.
#
# In practice yarn 1.22.22 rejects this project earlier than that, on its own
# corepack check against the "packageManager" field in package.json. This file
# only does the work when that check is bypassed (e.g. YARN_IGNORE_PATH).
#
# See scripts/ensure-npm.cjs for the reasoning and the npm equivalents.
yarn-path "./scripts/ensure-npm.cjs"
