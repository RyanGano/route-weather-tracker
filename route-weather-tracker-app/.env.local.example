# Copy this file to .env.local for local development.
# .env.local is listed in .gitignore and will NOT be committed.
#
# All VITE_* variables are build-time — Vite bakes them into the JS bundle.
# For production (Azure SWA / Vercel), add these as Repository Variables
# in GitHub Actions (Settings → Secrets and variables → Variables) so they
# are injected during the "npm run build" CI step.

# ── Core API ─────────────────────────────────────────────────────────────────
# URL of the backend API. In dev this is handled by the Vite proxy (Aspire),
# so you can leave this blank locally.
VITE_API_URL=

# ── Advertising & Affiliate Links ────────────────────────────────────────────
# Set to "true" to enable the ad / affiliate banner and per-pass micro-offers.
VITE_ADS_ENABLED=true

# Amazon Associates tracking tag (e.g. yoursite-20).
# Sign up: https://affiliate-program.amazon.com
VITE_AMAZON_ASSOCIATE_TAG=

# Booking.com affiliate ID (numeric, e.g. 1234567).
# Sign up: https://www.booking.com/affiliate-program
VITE_BOOKING_AFFILIATE_ID=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# Required for AdSense fallback. Leave blank to skip AdSense entirely.
# Sign up: https://adsense.google.com
VITE_ADSENSE_PUBLISHER_ID=

# AdSense ad unit ID. Available after AdSense site approval and unit creation.
# Leave blank until your site has been approved — affiliate cards will still work.
VITE_ADSENSE_AD_UNIT_ID=
