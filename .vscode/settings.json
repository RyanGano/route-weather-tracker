    "dotnet restore": true,
    "dotnet build": true,
    "dotnet remove": true,
    "git add": true,
    "git commit": true,
    "dotnet new": true,
    "dotnet sln": true,
    "dotnet test": true,
    "npm install": true,
    "npm ci": true,
    "dotnet package": true,
    "npx tsc": true,
    "git push": true,
    "npm run": true,
    "git rev-parse": true,
    "dotnet run": true,
    "Receive-Job": true,
    "Start-Job": true,
    "/^cd route-weather-tracker-app ; npm install$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "true": true,
    "npm audit": true
  }
